# Local SQLite database (development)
DATABASE_URL="file:./dev.db"

# Set to a PostgreSQL connection string in production (Prisma Postgres / Neon / Supabase)
# DATABASE_URL="postgresql://user:password@host:5432/hemonexus"

# Authentication secret - generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret"

# Public URL of the deployed Express API (leave empty to use Next.js route handlers)
NEXT_PUBLIC_API_URL=""

# Python FastAPI intelligence service (optional; local fallback is built in)
INTELLIGENCE_URL="http://127.0.0.1:8000"
